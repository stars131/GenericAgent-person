# GenericAgent .env example — copy to `.env` and fill in your keys.
#
# `.env` is the simplest way to get started: drop one of these keys in,
# run the agent, and you're off. No mykey.py needed for the first run.
#
# Resolution order (see docs/CONFIG.md):
#   1. Shell env vars (always win)
#   2. .env (this file — values shown below are placeholders)
#   3. mykey.py / mykey_local_override.py
#   4. mykey.json
#   5. Synthesized from .env-recognized keys (last-resort fallback)
#
# Anything you write here is loaded into os.environ at startup, so a
# hand-written mykey.py can also `os.environ.get('OPENAI_API_KEY')`
# instead of hard-coding secrets.

# ── OpenAI / OAI-compatible (recommended for first-run) ──
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.4

# ── Anthropic (real endpoint or any CC-relay) ──
# Real Anthropic key (sk-ant-*) → real endpoint, no fake_cc fingerprint.
# Anything else (sk-*, cr_*, sk-user-*) → assumed relay, fake_cc enabled.
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-opus-4-7

# ── GA_-prefixed alternates ──
# Use these when you want a value scoped to GenericAgent only — e.g. you
# already have OPENAI_API_KEY pointing at a different account for some
# other tool and don't want it leaking in.
# GA_OPENAI_API_KEY=sk-...
# GA_ANTHROPIC_API_KEY=sk-ant-...
